{
  "name": "bondmoran-hiring-partnership",
  "version": "0.1.0",
  "private": true,
  "description": "BondMoran Hiring Partnership prototype, powered by Elsewhere. Fictional data only.",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "next dev",
    "worker:dev": "tsx watch --conditions=react-server src/server/worker.ts",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "worker": "tsx --conditions=react-server src/server/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "demo:reset": "tsx --conditions=react-server scripts/reset.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "check:env": "tsx --conditions=react-server scripts/check-env.ts",
    "check:seed": "tsx --conditions=react-server scripts/check-seed.ts",
    "check:sentry": "tsx --conditions=react-server scripts/sentry-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@aws-sdk/client-s3": "3.1163.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "7.0.3",
    "@sentry/nextjs": "11.8.0",
    "@sentry/node": "11.8.0",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.69.0",
    "mammoth": "1.13.0",
    "next": "16.4.5",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module"
}
